{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/desktop/dist/renderer",
  "crons": [
    { "path": "/api/cron/archive-rooms", "schedule": "0 3 * * *" },
    { "path": "/api/notifications-push", "schedule": "0 * * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
